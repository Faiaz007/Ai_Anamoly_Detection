# Google Gemini AI configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

PORT=3000

# Anomaly detection thresholds (ms)
HIGH_RESPONSE_TIME_MS=3000
CRITICAL_RESPONSE_TIME_MS=5000

# Email (optional) - configure SMTP to enable anomaly report emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=
